#include <winver.h>
#include "launcher_version.h"

IDI_ICON1 ICON "launcher.ico"

1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LAUNCHER_VERSION_MAJOR, LAUNCHER_VERSION_MINOR, LAUNCHER_VERSION_PATCH, 0
PRODUCTVERSION LAUNCHER_VERSION_MAJOR, LAUNCHER_VERSION_MINOR, LAUNCHER_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "inFAMOUS PC Edition"
            VALUE "FileDescription", "inFAMOUS PC Launcher"
            VALUE "FileVersion", LAUNCHER_VERSION
            VALUE "InternalName", "Launcher"
            VALUE "OriginalFilename", "Launcher.exe"
            VALUE "ProductName", "inFAMOUS PC Launcher"
            VALUE "ProductVersion", LAUNCHER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
