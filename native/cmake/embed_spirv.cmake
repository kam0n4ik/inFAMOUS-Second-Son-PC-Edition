# Converts a SPIR-V binary into a C++ header with a uint32_t array.
#   cmake -DINPUT=<file.spv> -DOUTPUT=<file.h> -DSYMBOL=<name> -P embed_spirv.cmake
file(READ "${INPUT}" content HEX)
string(LENGTH "${content}" hex_len)
math(EXPR byte_len "${hex_len} / 2")
math(EXPR rem "${byte_len} % 4")
if(NOT rem EQUAL 0 OR byte_len EQUAL 0)
    message(FATAL_ERROR "${INPUT}: size ${byte_len} is not a multiple of 4")
endif()
set(words "")
set(i 0)
while(i LESS hex_len)
    # little-endian bytes -> one 32-bit word
    string(SUBSTRING "${content}" ${i} 2 b0)
    math(EXPR i1 "${i} + 2")
    string(SUBSTRING "${content}" ${i1} 2 b1)
    math(EXPR i2 "${i} + 4")
    string(SUBSTRING "${content}" ${i2} 2 b2)
    math(EXPR i3 "${i} + 6")
    string(SUBSTRING "${content}" ${i3} 2 b3)
    string(APPEND words "0x${b3}${b2}${b1}${b0},")
    math(EXPR i "${i} + 8")
    math(EXPR col "(${i} / 8) % 8")
    if(col EQUAL 0)
        string(APPEND words "\n")
    endif()
endwhile()
file(WRITE "${OUTPUT}" "// Generated from ${INPUT} - do not edit.\n#pragma once\n#include <cstdint>\ninline constexpr uint32_t ${SYMBOL}[] = {\n${words}\n};\n")
